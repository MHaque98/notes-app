# API Configuration
# For local development with SAM Local backend (default):
# Leave VITE_API_URL unset or set to "/api" to use Vite proxy (proxies to http://localhost:3000)
# 
# For local development with MSW mocks:
# Set VITE_ENABLE_MSW=true and leave VITE_API_URL unset
#
# For production:
# Set VITE_API_URL to your production API Gateway endpoint

# API Base URL (defaults to "/api" which uses Vite proxy in dev)
# VITE_API_URL=/api

# Enable MSW (Mock Service Worker) for local development
# Set to "true" to use mocks instead of real API
# VITE_ENABLE_MSW=false